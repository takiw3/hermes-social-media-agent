# Credentials and secrets. None of these ever belong in this repository.
.env
.env.*
!.env.template
auth.json
*token*.json
client_secret*.json
mcp_tokens.json
*.pem
*.p12
*.key
.heygen/
credentials

# Hermes runtime state. User-owned, never distributed.
memories/
sessions/
logs/
plans/
workspace/
home/
local/
checkpoints/
sandboxes/
backups/
cache/
.cache/
image_cache/
audio_cache/
document_cache/
browser_screenshots/
active_profile
gateway.pid
gateway_state.json
processes.json
.hermes_history
errors.log
.update_check

# Runtime databases
*.db
*.db-shm
*.db-wal
*.sqlite

# Video toolchain: installed by the owner, never committed.
node_modules/
engine.json
footage-manifest.json
chrome/
chrome-headless-shell*/
*.onnx
*.gguf
*.safetensors

# The owner's footage, audio, renders, and snapshots.
# Patterns are anchored to names, not to *.mp3, because the vendored
# HyperFrames skills ship licensed sound effects that must stay tracked.
footage/
renders/
receipts/
snapshots/
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.m4a

# Generated work and owner data.
exports/
analytics/
comments/
transcripts/
drafts/
reports/
*.csv
*.xlsx

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# OS and editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
